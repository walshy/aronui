# ============================================================
# Aronui — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase (required)
# Found in: Supabase dashboard → Project Settings → API
# ----------------------------------------------------------

# Public URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER SIDE ONLY, never expose to the browser
# Used by the ingestion script and any admin server actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------
# Anthropic (server side only)
# Found in: https://console.anthropic.com/account/keys
# ----------------------------------------------------------

ANTHROPIC_API_KEY=your-anthropic-api-key

# ----------------------------------------------------------
# App settings
# ----------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
